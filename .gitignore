node_modules/
npm-debug.log*
coverage/
.DS_Store
*.local
.env

# Worker scratch space: snippet deliverables land under work/<task-id>/. The DB
# stores only path references (ADR 0003). Accepted demo outputs are committed
# deliberately (M6b); routine run output stays out of git.
work/

# opencode runtime: keep our authored skill + agent; ignore opencode's own
# scaffolding (node_modules, plugin manifest).
.opencode/*
!.opencode/agent/
!.opencode/skill/

# Autonomous-loop run artifacts: per-poller logs + the STOP sentinel (M14). The
# scripts + config under loop/ are committed; only runtime output is ignored.
loop/run/

# Per-sweep git worktrees for isolated parallel implementers (M17). Live checkouts
# over the shared object store; created/torn down by loop/worktree.sh, never committed.
.loop-worktrees/
