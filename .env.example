# Copy to .env to OVERRIDE the dev defaults baked into docker-compose.yml and
# test/config.ts. The stack and tests run with no .env at all (defaults match);
# .env exists only for local overrides and is gitignored.
#
# Production supplies real values via the environment — never commit real secrets.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ainarres

# Must match the authenticator role password in the bootstrap migration.
AUTHENTICATOR_PASSWORD=authenticator_dev_pw

# PostgREST HS256 secret (must be >= 32 chars). Dev-only.
JWT_SECRET=ainarres-dev-only-secret-change-me-min-32-chars

# Host ports (mapped to the containers' 5432/3000). Defaults avoid common conflicts.
DB_PORT=5432
PGRST_PORT=3010
# NB: not BASE_URL — that name is reserved by Vite/Vitest (the app base path).
AINARRES_BASE_URL=http://localhost:3010
