# Autonomous-loop substrate (ADR 0020 § pollution-proofing, M13).
#
# This is a SECOND, isolated AINARRES instance — the one the hands-off v3 loop
# coordinates its `dev` board on. It is deliberately separate from the TEST
# substrate that `make reset`/the vitest suite use (compose project `ainarres`,
# ports 5433/3010). Keeping them apart is what makes an unattended run
# pollution-proof: a `validating`-stage `make reset` rebuilds the TEST substrate
# and never touches the loop's live board (the M11 incident — retro m11-bootstrap).
#
# Unlike `.env`, this file IS committed: it is shared run configuration, not a
# secret. Production never uses it.
#
# Bring it up with the `loop-*` Makefile targets (which pass `-p ainarres-loop
# --env-file loop.env`). The driver/pollers (M14) source this so the `ainarres`
# CLI talks to the loop instance via AINARRES_BASE_URL below.

# Distinct compose project → distinct containers, network, and data volume.
COMPOSE_PROJECT_NAME=ainarres-loop

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ainarres

# Must match the authenticator role password in the bootstrap migration.
AUTHENTICATOR_PASSWORD=authenticator_dev_pw

# Same dev-only HS256 secret so locally-minted tokens work against either
# instance. Production supplies a real secret via the environment.
JWT_SECRET=ainarres-dev-only-secret-change-me-min-32-chars

# Host ports — distinct from the test substrate's 5433/3010 so both run at once.
DB_PORT=5434
PGRST_PORT=3011
# NB: not BASE_URL — that name is reserved by Vite/Vitest (the app base path).
AINARRES_BASE_URL=http://localhost:3011
